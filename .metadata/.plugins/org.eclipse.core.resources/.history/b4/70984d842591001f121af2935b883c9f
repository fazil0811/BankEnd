package com.vehicle;

import java.util.List;

import org.apache.log4j.Logger;
import org.apache.log4j.PropertyConfigurator;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PatchMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

@RestController
@RequestMapping(value = "/vehicle")
public class VehicleController {

	@Autowired
	VehicleService vs;
	
	static Logger log=Logger.getLogger(VehicleController.class);

	@PostMapping(value = "/postVehicle")
	public String postThis(@RequestBody Vehicle a) {
		PropertyConfigurator.configure("log4jj.properties");
		log.info(vs.postThis(a));
		return vs.postThis(a);
	}

	@PostMapping(value = "/postVeh")
	public String postThat(@RequestBody List<Vehicle> a) {
		return vs.postThat(a);
		
	}

	@GetMapping(value = "/getDetails")
	public List<Vehicle> getVehicles() {
		
		PropertyConfigurator.configure("log4jj.properties");
		log.info(vs.getVehicles());
		return vs.getVehicles();
	}

	@GetMapping(value = "/getDet")
	public Vehicle getDet(@RequestParam int a) {
		return vs.getDet(a);
	}

	@PutMapping(value = "/putVehicle")
	public String putVehicle(@RequestBody Vehicle a) {
		return vs.putVehicle(a);
	}

	@PatchMapping(value = "/patchVehicle/{a}")	
	public String patchThis(@PathVariable int a, @RequestBody Vehicle v) {
		return vs.patchThis(a, v);

	}
	
	@DeleteMapping(value="/getRemove")
	public String getRemove(@RequestParam int a) {
		return vs.getRemove(a);
	}
}
